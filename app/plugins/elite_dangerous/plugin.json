{
  "name": "elite_dangerous",
  "version": "1.0",
  "display_name": "Elite Dangerous",
  "description": "",
  "icon": "videogame_asset",
  "type": "service",
  "exe_default": "EliteDangerous64.exe",
  "message_not_running": "Elite Dangerous is not running. The plugin will activate when the game is detected.",
  "min_api_version": "2.0",

  "capabilities": {
    "status": true,
    "configuration": true,
    "outputs": true,
    "live_data": true,
    "actions": false,
    "diagnostics": false
  },

  "labels": {
    "status": "CONNECTION",
    "configuration": "GAME DETECTION",
    "outputs": "OUTPUT ROUTING",
    "live_data": "GAME STATE"
  },

  "status": [
    { "key": "status_code", "label": "Status", "source": "lifecycle" },
    { "key": "commander", "label": "Commander", "source": "plugin" },
    { "key": "system", "label": "System", "source": "plugin" }
  ],

  "outputs": [
    { "id": "overlay", "label": "Overlay", "enabled": true },
    { "id": "dashboard", "label": "Dashboard", "enabled": true },
    { "id": "display", "label": "Hardware Display", "enabled": false }
  ],

  "live_data": {
    "title": "Telemetry",
    "fields": [
      { "key": "ship", "label": "Ship", "type": "string" },
      { "key": "system", "label": "System", "type": "string" },
      { "key": "fuel", "label": "Fuel", "type": "float" }
    ]
  },

  "settings": [
    {
      "title": "Game Detection",
      "controls": [
        {
          "type": "toggle",
          "key": "enabled",
          "label": "Enabled",
          "description": "Start plugin when Elite Dangerous is detected"
        },
        {
          "type": "folder_picker",
          "key": "exe_path",
          "label": "Target executable",
          "description": "Plugin starts when this process is detected"
        }
      ]
    }
  ]
}

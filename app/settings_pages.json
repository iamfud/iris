{
  "pages": [
    {
      "id": "features",
      "title": "Companion Device",
      "subtitle": "Configure companion device",
      "icon": "widgets",
      "nav_group": "main",
      "sections": [
        {
          "title": "Clock Display",
          "controls": [
            {
              "type": "select",
              "key": "clock_mode",
              "label": "Clock Mode",
              "value_from": "_clock_mode",
              "options": [
                { "value": "small", "label": "Small Clock" },
                { "value": "large", "label": "Large Clock", "set": { "feature_large_clock": true, "feature_day_clock": false } },
                { "value": "day", "label": "Day and time", "set": { "feature_large_clock": false, "feature_day_clock": true } }
              ]
            },
            {
              "type": "toggle",
              "key": "feature_greeting",
              "label": "Greeting message",
              "description": "Show greeting message on startup"
            },
            {
              "type": "toggle",
              "key": "feature_time",
              "label": "Time display",
              "description": "Show/hide the current time on the display"
            },
            {
              "type": "toggle",
              "key": "feature_date",
              "label": "Date reminder",
              "description": "Alternate time display with the current date"
            },
            {
              "type": "toggle",
              "key": "feature_minute_bar",
              "label": "Minute bar",
              "description": "Visual minute progress bar on the display"
            }
          ]
        },
        {
          "title": "Display",
          "controls": [
            {
              "type": "slider",
              "key": "brightness",
              "label": "MAX7219 Brightness",
              "min": 0,
              "max": 4,
              "step": 1,
              "unit": "",
              "description": "Brightness of the companion MAX7219 display (0 = off)"
            }
          ]
        },
        {
          "title": "Extras",
          "controls": [
            {
              "type": "toggle",
              "key": "feature_eyes",
              "label": "Animated eyes",
              "description": "Animated eyes that follow motion"
            },
            {
              "type": "toggle",
              "key": "feature_notifications",
              "label": "Notifications",
              "description": "Show phone/PC notifications on the display"
            },
            {
              "type": "toggle",
              "key": "night_mode_enabled",
              "label": "Night mode",
              "description": "Dim display during nighttime hours"
            },
            {
              "type": "toggle",
              "key": "pc_stats_enabled",
              "label": "PC Stats",
              "description": "Show PC hardware stats on the display"
            }
          ]
        }
      ]
    },
    {
      "id": "notifications",
      "title": "Notifications",
      "subtitle": "Coming soon",
      "icon": "notifications",
      "nav_group": "main",
      "sections": []
    },
    {
      "id": "settings",
      "title": "Settings",
      "subtitle": "Application settings",
      "icon": "settings",
      "nav_group": "bottom",
      "sections": [
        {
          "title": "Personalization",
          "controls": [
            {
              "type": "text",
              "key": "user_name",
              "label": "Your Name",
              "placeholder": "Your Name",
              "description": "Used by Iris to personalize welcome greetings and system messages.",
              "save_debounce_ms": 300
            }
          ]
        },
        {
          "title": "Screenshots & Library",
          "controls": [
            {
              "type": "folder_picker",
              "key": "screenshot_dir",
              "label": "Screenshot folder",
              "description": "Where captures and notes are saved. Default: Documents\\Iris\\Screenshots. Leave empty to use default."
            },
            {
              "type": "button",
              "label": "Open Library",
              "icon": "photo_library",
              "action": "navigate",
              "target": "library"
            }
          ]
        },
        {
          "title": "Media Player",
          "full_width": true,
          "controls": [
            {
              "type": "media_player_picker",
              "key": "media_player_path",
              "label": "Player Application (Eject)",
              "description": "Application launched when pressing the Player / Eject button."
            }
          ]
        },
        {
          "title": "Appearance",
          "full_width": true,
          "controls": [
            {
              "type": "theme",
              "key": "theme",
              "label": "Theme Engine"
            }
          ]
        },
        {
          "title": "Network",
          "app_only": true,
          "full_width": true,
          "qr_top_right": true,
          "instructions": [
            "The panel binds to localhost by default, so no login is needed on this PC.",
            "To reach it from your phone, turn on Allow LAN access, then scan the QR code at the top right. Scanning opens the pairing page on your phone over HTTPS (a secure connection needed to keep the phone's screen awake on the live panel).",
            "The first time you open the HTTPS address, your phone shows a self-signed certificate warning — tap through it once, then re-add the home-screen icon from the HTTPS address if you had one.",
            "Set a panel password below, then enter it on your phone to pair it. A paired phone stays connected until you revoke it in the list below."
          ],
          "controls": [
            {
              "type": "toggle",
              "key": "lan_access",
              "label": "Allow LAN access",
              "description": "Allow devices on your network to reach the panel. Restart required. Remote devices must pair by entering the panel password."
            },
            {
              "type": "qr",
              "key": "lan_url",
              "label": "Scan to pair",
              "description": "Scan from your phone to open the pairing page — enter your panel password there to connect."
            },
            {
              "type": "apk_download",
              "label": "Android Companion App",
              "description": "Download and install the native Android Iris.apk directly on your phone."
            },
            {
              "type": "password",
              "key": "panel_password",
              "label": "Panel password",
              "description": "Phones must enter this password to pair with the panel. Set it once, change it any time."
            },
            {
              "type": "devices",
              "label": "Paired devices",
              "description": "Devices that have entered the panel password to pair. Revoke any you no longer trust — the phone is signed out immediately."
            }
          ]
        }
      ]
    }
  ],
  "control_types": {
    "toggle": {
      "description": "Boolean switch — on/off toggle",
      "fields": ["key", "label", "description"]
    },
    "text": {
      "description": "Text input field",
      "fields": ["key", "label", "placeholder", "save_debounce_ms"]
    },
    "password": {
      "description": "Panel pairing password (set / change via dialog)",
      "fields": ["key", "label", "description"]
    },
    "select": {
      "description": "Dropdown select",
      "fields": ["key", "label", "options", "value_from"]
    },
    "slider": {
      "description": "Range slider with value display",
      "fields": ["key", "label", "min", "max", "step", "unit"]
    },
    "number": {
      "description": "Numeric input",
      "fields": ["key", "label", "min", "max", "step", "unit"]
    },
    "button": {
      "description": "Action button",
      "fields": ["label", "icon", "action", "target"]
    },
    "info": {
      "description": "Read-only info display",
      "fields": ["key", "label", "value"]
    },
    "folder_picker": {
      "description": "Text input with browse-for-folder button",
      "fields": ["key", "label"]
    },
    "file_picker": {
      "description": "Text input with browse-for-file button",
      "fields": ["key", "label", "file_types"]
    }
  }
}

{
  "name": "ha",
  "version": "1.0",
  "display_name": "Home Assistant",
  "description": "Connect to Home Assistant to control smart lights, switches, and monitor home state.",
  "icon": "home",
  "type": "service",
  "message_not_running": "Home Assistant is not reachable. Verify your URL and access token.",
  "min_api_version": "2.0",
  "capabilities": {
    "status": true,
    "configuration": true,
    "outputs": true,
    "live_data": true,
    "actions": true,
    "diagnostics": false
  },
  "labels": {
    "status": "CONNECTION",
    "configuration": "HOME ASSISTANT SETTINGS",
    "outputs": "OUTPUT ROUTING",
    "live_data": "HOME STATE"
  },
  "status": [
    {
      "key": "status_code",
      "label": "Status",
      "source": "lifecycle"
    },
    {
      "key": "version",
      "label": "HA Version",
      "source": "plugin"
    },
    {
      "key": "location_name",
      "label": "Instance",
      "source": "plugin"
    }
  ],
  "outputs": [
    {
      "id": "overlay",
      "label": "Overlay",
      "enabled": false
    },
    {
      "id": "dashboard",
      "label": "Dashboard",
      "enabled": true
    },
    {
      "id": "display",
      "label": "Hardware Display",
      "enabled": false
    }
  ],
  "live_data": {
    "title": "Home Assistant Status",
    "fields": [
      {
        "key": "connected",
        "label": "Connected",
        "type": "boolean"
      },
      {
        "key": "url",
        "label": "Server URL",
        "type": "string"
      },
      {
        "key": "location_name",
        "label": "Location",
        "type": "string"
      },
      {
        "key": "version",
        "label": "HA Version",
        "type": "string"
      }
    ]
  },
  "settings": [
    {
      "title": "Connection",
      "controls": [
        {
          "type": "text",
          "key": "url",
          "label": "Server URL",
          "description": "e.g. http://homeassistant.local:8123 or http://192.168.1.100:8123"
        },
        {
          "type": "text",
          "key": "token",
          "label": "Long-Lived Access Token",
          "description": "Created in Home Assistant under your User Profile > Security"
        },
        {
          "type": "button",
          "key": "discover",
          "id": "discover",
          "label": "Discover on Network",
          "icon": "radar",
          "action": "discover"
        },
        {
          "type": "button",
          "key": "reconnect",
          "id": "reconnect",
          "label": "Test & Reconnect",
          "icon": "sync",
          "action": "reconnect"
        }
      ]
    }
  ]
}
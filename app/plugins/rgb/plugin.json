{
  "name": "rgb",
  "version": "1.1",
  "display_name": "RGB & LCD Hardware",
  "description": "Unified RGB lighting control (OpenRGB) and AIO LCD screen integrations (NZXT Kraken, Ajazz AKP02).",
  "icon": "palette",
  "type": "service",
  "category": "hardware",
  "message_not_running": "RGB / OpenRGB service not connected.",
  "min_api_version": "2.0",

  "capabilities": {
    "hardware": true,
    "lighting_provider": true,
    "lcd_target": true,
    "status": true,
    "configuration": true,
    "outputs": true,
    "live_data": true,
    "actions": true,
    "diagnostics": false
  },

  "labels": {
    "status": "CONNECTION",
    "configuration": "RGB & LCD SETTINGS",
    "outputs": "OUTPUT ROUTING",
    "live_data": "HARDWARE STATUS"
  },

  "status": [
    { "key": "status_code", "label": "Status", "source": "lifecycle" },
    { "key": "sdk_version", "label": "SDK Version", "source": "plugin" },
    { "key": "device_count", "label": "RGB Devices", "source": "plugin" },
    { "key": "ajz_connected", "label": "Ajazz LCD", "source": "plugin" }
  ],

  "outputs": [
    { "id": "overlay", "label": "Overlay", "enabled": false },
    { "id": "dashboard", "label": "Dashboard", "enabled": true },
    { "id": "display", "label": "Hardware Display", "enabled": false }
  ],

  "live_data": {
    "title": "Connected Hardware",
    "fields": [
      { "key": "device_count", "label": "RGB Devices", "type": "int" },
      { "key": "active_profile", "label": "Active Profile", "type": "string" },
      { "key": "kraken_model", "label": "NZXT Kraken AIO", "type": "string" },
      { "key": "ajz_model", "label": "Ajazz LCD Display", "type": "string" },
      { "key": "ajz_connected", "label": "Ajazz Connected", "type": "bool" },
      { "key": "ajz_brightness", "label": "Ajazz Brightness", "type": "int" }
    ]
  },

  "settings": [
    {
      "title": "OpenRGB Control",
      "controls": [
        {
          "type": "toggle",
          "key": "enabled",
          "label": "Enable OpenRGB",
          "description": "Connect to OpenRGB SDK server"
        },
        {
          "type": "select",
          "key": "profile",
          "label": "Default Profile",
          "options_key": "profiles"
        }
      ]
    },
    {
      "title": "AIO LCD Integration",
      "controls": [
        {
          "type": "toggle",
          "key": "kraken_enabled",
          "label": "Enable NZXT Kraken LCD",
          "description": "Probe and stream telemetry to NZXT Kraken LCD displays"
        }
      ]
    },
    {
      "title": "Ajazz AKP02 LCD Display",
      "controls": [
        {
          "type": "toggle",
          "key": "ajz_enabled",
          "label": "Enable Ajazz LCD",
          "description": "Probe and manage Ajazz AKP02 LCD screen"
        },
        {
          "type": "slider",
          "key": "ajz_brightness",
          "label": "Screen Brightness",
          "description": "Adjust hardware backlight brightness (0-100%)",
          "min": 0,
          "max": 100,
          "default": 80,
          "step": 5
        }
      ]
    }
  ]
}

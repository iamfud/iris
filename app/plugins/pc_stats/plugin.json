{
  "name": "pc_stats",
  "version": "1.0",
  "display_name": "PC Stats",
  "description": "CPU/GPU temperature and FPS monitoring",
  "icon": "memory",
  "type": "multi",
  "requirements": [
    {"name": "RTSS", "exe": "RTSS.exe", "description": "RivaTuner Statistics Server", "url": "https://www.guru3d.com/download/rtss-rivatuner-statistics-server-download/"},
    {"name": "Afterburner", "exe": "MSIAfterburner.exe", "description": "MSI Afterburner", "url": "https://www.msi.com/Landing/afterburner/graphics-cards"}
  ],
  "message_not_running": "PC Stats requires RTSS and MSI Afterburner to be running.",
  "min_api_version": "2.0",

  "capabilities": {
    "status": true,
    "configuration": true,
    "outputs": true,
    "live_data": true,
    "actions": true,
    "diagnostics": false
  },

  "labels": {
    "outputs": "OUTPUT ROUTING",
    "actions": "COMMANDS"
  },

  "status": [
    { "key": "status_code", "label": "Status", "source": "lifecycle" },
    { "key": "type", "label": "Type", "source": "lifecycle" }
  ],

  "outputs": [
    { "id": "overlay", "label": "Overlay", "enabled": true },
    { "id": "dashboard", "label": "Dashboard", "enabled": true },
    { "id": "display", "label": "Hardware Display", "enabled": true }
  ],

  "live_data": {
    "title": "Hardware Stats",
    "fields": [
      { "key": "cpu_temp", "label": "CPU Temperature", "type": "float" },
      { "key": "gpu_temp", "label": "GPU Temperature", "type": "float" },
      { "key": "fps", "label": "FPS", "type": "int" }
    ]
  },

  "settings": [
    {
      "title": "Temperature Limits",
      "controls": [
        {
          "type": "toggle",
          "key": "enabled",
          "label": "Enabled",
          "description": "Show PC hardware stats on the display"
        },
        {
          "type": "toggle",
          "key": "use_fahrenheit",
          "label": "Use Fahrenheit (\u00b0F)",
          "description": "Set temperature limits in degrees Fahrenheit"
        },
        {
          "type": "slider",
          "key": "cpu_temp_lim",
          "label": "CPU Temperature Limit",
          "min": 50,
          "max": 100,
          "step": 5,
          "unit": "\u00b0C"
        },
        {
          "type": "slider",
          "key": "gpu_temp_lim",
          "label": "GPU Temperature Limit",
          "min": 50,
          "max": 100,
          "step": 5,
          "unit": "\u00b0C"
        }
      ]
    }
  ]
}

{
  "name": "openrgb",
  "version": "1.0",
  "display_name": "OpenRGB",
  "description": "Control RGB lighting via OpenRGB SDK server",
  "icon": "palette",
  "type": "service",
  "message_not_running": "OpenRGB SDK server is not running. Start OpenRGB with the SDK server enabled.",
  "min_api_version": "2.0",

  "capabilities": {
    "status": true,
    "configuration": true,
    "outputs": true,
    "live_data": true,
    "actions": false,
    "diagnostics": false
  },

  "labels": {
    "status": "CONNECTION",
    "configuration": "RGB CONTROL",
    "outputs": "OUTPUT ROUTING",
    "live_data": "DEVICES"
  },

  "status": [
    { "key": "status_code", "label": "Status", "source": "lifecycle" },
    { "key": "sdk_version", "label": "SDK Version", "source": "plugin" },
    { "key": "device_count", "label": "Devices", "source": "plugin" }
  ],

  "outputs": [
    { "id": "overlay", "label": "Overlay", "enabled": false },
    { "id": "dashboard", "label": "Dashboard", "enabled": true },
    { "id": "display", "label": "Hardware Display", "enabled": false }
  ],

  "live_data": {
    "title": "RGB Devices",
    "fields": [
      { "key": "device_count", "label": "Connected devices", "type": "int" },
      { "key": "active_profile", "label": "Active profile", "type": "string" }
    ]
  },

  "settings": [
    {
      "title": "RGB Control",
      "controls": [
        {
          "type": "toggle",
          "key": "enabled",
          "label": "Enabled",
          "description": "Connect to OpenRGB SDK server"
        },
        {
          "type": "select",
          "key": "profile",
          "label": "Profile",
          "options_key": "openrgb_profiles"
        }
      ]
    }
  ]
}
